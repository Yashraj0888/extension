// === APP STATE ===
const state = {
  route: "home",
  currentMeetingId: null,
  currentMeeting: null,
  currentTab: "chat",
  isSidebarCollapsed: false,
  isGenerating: false,
  settingsTab: "providers",
  editingTemplateId: "default",
  pendingSearchQuery: "",
  focusMode: false,
  askSelectedIds: [],
  askMeetingsCache: new Map(),
  askShowPrompts: false,
};

// === DOM REFS ===
const dom = {};
